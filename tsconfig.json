{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solid-gpui/core",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "@solid-gpui/core": ["./vendor/solid-gpui/packages/solid-gpui/src/index.ts"],
      "@solid-gpui/core/runtime": ["./vendor/solid-gpui/packages/solid-gpui/src/runtime.ts"],
      "@solid-gpui/core/stdio": ["./vendor/solid-gpui/packages/solid-gpui/src/stdio.ts"],
      "@solid-gpui/core/native": ["./vendor/solid-gpui/packages/solid-gpui/src/native.ts"],
      "@solid-gpui/core/motion": ["./vendor/solid-gpui/packages/solid-gpui/src/motion.ts"],
      "@solid-gpui/core/components": ["./src/generated/native.ts"],
      "@solid-gpui/core/jsx-runtime": ["./vendor/solid-gpui/packages/solid-gpui/src/jsx-runtime.ts"],
      "#native": ["./src/generated/native.ts"],
      "@solid-gpui/router": ["./vendor/solid-gpui/packages/solid-gpui-router/src/index.ts"],
      "@server/*": ["./src/*"]
    }
  },
  "include": ["src", "scripts", "vite.config.ts"]
}
