{
  "name": "r5-server",
  "version": "2.0.0",
  "private": true,
  "description": "R5Flowstate dedicated server native management panel",
  "type": "module",
  "imports": {
    "#server/*": "./src/*.ts"
  },
  "scripts": {
    "generate": "solid-gpui prepare",
    "check:generated": "solid-gpui prepare --check",
    "doctor": "solid-gpui doctor",
    "typecheck": "tsc --noEmit",
    "dev": "bun --bun vite",
    "test": "solid-gpui test",
    "build": "bun --bun vite build",
    "preview": "solid-gpui preview",
    "package": "bun run scripts/build.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --disable-nested-config --check",
    "check": "bun run typecheck && bun run lint && bun run fmt:check"
  },
  "dependencies": {
    "@solid-gpui/core": "file:vendor/sdk-tarballs/solid-gpui-core.tgz",
    "@solid-gpui/router": "file:vendor/sdk-tarballs/solid-gpui-router.tgz",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "dotenv": "^17.4.2",
    "keyvalues-tools": "^1.1.0",
    "shell-quote": "^1.10.0",
    "solid-js": "1.9.15",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@solid-gpui/vite": "file:vendor/sdk-tarballs/solid-gpui-vite.tgz",
    "@types/bun": "^1.4.2",
    "@types/shell-quote": "^1.7.5",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "8.2.2"
  }
}
